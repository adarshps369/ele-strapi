{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "Comprehensive SEO and custom head/body script fields"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "metaKeywords": {
      "type": "string"
    },
    "metaRobots": {
      "type": "string",
      "default": "index, follow"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "customHeadScripts": {
      "type": "text"
    },
    "customBodyScripts": {
      "type": "text"
    }
  }
}
